options {
    directory "/var/cache/bind";

    listen-on { 127.0.0.1; 192.168.0.10; };
    listen-on-v6 { ::1; FD00:DB80:192:0::10; };

    recursion yes;

    allow-query {
        localhost;
        192.168.0.0/24;
        192.168.10.0/24;
        192.168.20.0/24;
        192.168.30.0/24;
        192.168.40.0/24;
        192.168.50.0/24;
        192.168.60.0/24;
        192.168.70.0/24;
        192.168.80.0/24;
        192.168.90.0/24;
        192.168.100.0/24;
        192.168.110.0/24;
        192.168.120.0/24;

        FD00:DB80:192:0::/64;
        FD00:DB80:0:10::/64;
        FD00:DB80:0:20::/64;
        FD00:DB80:0:30::/64;
        FD00:DB80:0:40::/64;
        FD00:DB80:0:50::/64;
        FD00:DB80:0:60::/64;
        FD00:DB80:0:70::/64;
        FD00:DB80:0:80::/64;
        FD00:DB80:0:90::/64;
        FD00:DB80:0:100::/64;
        FD00:DB80:0:110::/64;
        FD00:DB80:0:120::/64;
    };

    allow-recursion {
        localhost;
        192.168.0.0/24;
        192.168.10.0/24;
        192.168.20.0/24;
        192.168.30.0/24;
        192.168.40.0/24;
        192.168.50.0/24;
        192.168.60.0/24;
        192.168.70.0/24;
        192.168.80.0/24;
        192.168.90.0/24;
        192.168.100.0/24;
        192.168.110.0/24;
        192.168.120.0/24;

        FD00:DB80:192:0::/64;
        FD00:DB80:0:10::/64;
        FD00:DB80:0:20::/64;
        FD00:DB80:0:30::/64;
        FD00:DB80:0:40::/64;
        FD00:DB80:0:50::/64;
        FD00:DB80:0:60::/64;
        FD00:DB80:0:70::/64;
        FD00:DB80:0:80::/64;
        FD00:DB80:0:90::/64;
        FD00:DB80:0:100::/64;
        FD00:DB80:0:110::/64;
        FD00:DB80:0:120::/64;
    };

    forwarders {
        8.8.8.8;
    };

    forward only;

    dnssec-validation no;
};
